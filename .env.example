# Cuenta gratuita de Cloudflare: Workers AI > Use REST API.
# Conserva el plan Workers Free para que al agotar la cuota las llamadas se detengan.
AI_PROVIDER=cloudflare
# Texto: Groq → Gemini → Cloudflare; se omiten claves vacías. Solo planes Free.
GROQ_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
ENABLE_IMAGES=true

# Alternativa para narración local (instala Ollama y ejecuta ollama pull qwen3:4b):
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:4b
# ENABLE_IMAGES=false

# Voz del dispositivo por defecto. Voz natural opcional, consume mucha cuota.
ENABLE_VOICE=true

# Partidas privadas. Node >=24.15, disco persistente; no Edge ni disco efímero.
# GAME_DATA_DIR=.data
# Obligatorio para acceso por dominio, HTTPS o IP de la red local:
# APP_ORIGIN=https://tu-dominio.example

# Publicación en Vercel Hobby: no usa disco local.
# GAME_STORE=supabase
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_PUBLISHABLE_KEY=clave_publicable_solo_servidor
# DND_BACKEND_SECRET=credencial_backend_aleatoria_64_hex
# SAVE_KEY_BASE64=clave_de_32_bytes_en_base64_conservada_entre_despliegues
# DEMO_AI_DAILY_LIMIT=1000
